    "@tanstack/react-query": "^5.102.4",
    "better-auth": "^1.7.5",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
