FROM node:24-alpine AS build
RUN npm install -g corepack@latest && corepack enable && corepack prepare pnpm@11.17.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY mobile/package.json ./mobile/package.json
RUN pnpm install --frozen-lockfile --filter garde-manger-mobile...

COPY mobile ./mobile
ARG EXPO_PUBLIC_APP_BUILD=local
ARG EXPO_PUBLIC_API_URL=https://api-gardemanger.floriaaan.fr
ENV EXPO_PUBLIC_CONNECTOR=http \
    EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL \
    EXPO_PUBLIC_TELEMETRY_ENABLED=true \
    EXPO_PUBLIC_TELEMETRY_SAMPLE_RATIO=1 \
    EXPO_PUBLIC_APP_ENV=production \
    EXPO_PUBLIC_APP_BUILD=$EXPO_PUBLIC_APP_BUILD
RUN pnpm --filter garde-manger-mobile exec expo export --platform web

FROM nginx:stable-alpine
COPY mobile/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/mobile/dist /usr/share/nginx/html
EXPOSE 80
