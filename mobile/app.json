{
  "expo": {
    "name": "Garde-manger",
    "slug": "garde-manger-mobile",
    "version": "1.0.0",
    
    "icon": "./assets/images/icon.png",
    "scheme": "gardemanger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9F6D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/mascot.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#120D08",
            "image": "./assets/mascot.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Garde-manger a besoin de la caméra pour scanner le code-barres d'un produit."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Garde-manger a besoin d'accéder à tes photos pour importer un ticket de caisse."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
