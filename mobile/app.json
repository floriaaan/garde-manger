{
  "expo": {
    "name": "Garde-manger",
    "slug": "garde-manger",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "gardemanger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.floriaaan.gardemanger",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Garde-manger se connecte à ton serveur auto-hébergé sur le réseau local (par exemple http://192.168.1.20:3333) pour synchroniser ton frigo et ta liste de courses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9F6D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.floriaaan.gardemanger",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/mascot.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#120D08",
            "image": "./assets/mascot.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Garde-manger utilise la caméra pour scanner le code-barres d'un produit, photographier un ticket de caisse ou le contenu de ton frigo, et lire le QR code d'invitation d'un foyer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Garde-manger ouvre tes photos quand tu choisis d'importer la photo d'un ticket de caisse ou de ton frigo, pour en extraire les produits.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["application/pdf"],
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "floriaaan",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67dc1735-bcfd-4ccc-a8af-a84df72877b2"
      }
    }
  }
}
