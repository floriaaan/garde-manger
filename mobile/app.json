{
  "expo": {
    "name": "Garde-manger",
    "slug": "garde-manger",
    "version": "1.0.0-rc.1",
    "icon": "./assets/images/icon.png",
    "scheme": "gardemanger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.floriaaan.gardemanger",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9F6D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.floriaaan.gardemanger",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/mascot.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#120D08",
            "image": "./assets/mascot.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Garde-manger a besoin de la caméra pour scanner le code-barres d'un produit."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Garde-manger a besoin d'accéder à tes photos pour importer un ticket de caisse."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "floriaaan",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67dc1735-bcfd-4ccc-a8af-a84df72877b2"
      }
    }
  }
}
