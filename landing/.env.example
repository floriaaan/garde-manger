# `fake` = in-memory connector (no backend, no GitHub calls), `http` = real sources.
VITE_CONNECTOR=fake
# Backend serving GET /api/public/stats (needs PUBLIC_STATS_ENABLED=true and
# this site's origin in the backend's CORS_ORIGIN).
VITE_API_URL=http://localhost:3333
VITE_GITHUB_REPO=floriaaan/garde-manger
